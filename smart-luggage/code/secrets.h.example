#ifndef _SECRETS_H
#define _SECRETS_H

/* ============================================================================
 * 凭据与云端配置模板 —— 复制为 secrets.h 后填入自己的值
 *
 *   cp secrets.h.example secrets.h
 *
 * ⚠️ 真文件 secrets.h 已被项目根的 .gitignore 排除，**不会进版本库**。
 *    本模板（*.example）可以放心提交。
 *
 * 为什么要这么拆：原先这些字符串直接硬编码在 module/WIFI_Command.c 里，
 * 把工程推到 GitHub 就等于公开自家 WiFi 密码和云平台设备密钥。
 * 拆开之后仓库里只有模板，真凭据留在本地。
 * ========================================================================== */

/* ---------------- WiFi ---------------- */
#define WIFI_SSID          "your-wifi-ssid"
#define WIFI_PASSWORD      "your-wifi-password"

/* ---------------- OneNET（中国移动物联网平台）---------------- */
#define ONENET_PRODUCT_ID  "your-product-id"
#define ONENET_DEVICE_NAME "your-device-name"
#define ONENET_MQTT_HOST   "mqtts.heclouds.com"
#define ONENET_MQTT_PORT   "1883"

/* 鉴权 token。到 OneNET 控制台 → 设备 → 详情 里生成，形如：
 *   version=2018-10-31&res=products%2F<pid>%2Fdevices%2F<dev>&et=<过期时间戳>&method=md5&sign=<签名>
 * ⚠️ et 是【过期时间戳】。过期后设备连不上 MQTT，需要重新生成。 */
#define ONENET_AUTH_TOKEN  "version=2018-10-31&res=products%2Fyour-product-id%2Fdevices%2Fyour-device-name&et=0000000000&method=md5&sign=REPLACE_ME"

/* ---------------- MQTT 主题（topic）----------------
 * OneNET 物模型的标准主题，由 product id / device name 拼出来，不用手改。 */
#define ONENET_TOPIC_POST        "$sys/" ONENET_PRODUCT_ID "/" ONENET_DEVICE_NAME "/thing/property/post"
#define ONENET_TOPIC_POST_REPLY  "$sys/" ONENET_PRODUCT_ID "/" ONENET_DEVICE_NAME "/thing/property/post/reply"
#define ONENET_TOPIC_SET         "$sys/" ONENET_PRODUCT_ID "/" ONENET_DEVICE_NAME "/thing/property/set"

#endif
